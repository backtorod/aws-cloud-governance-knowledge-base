{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidencemark.com/schemas/knowledge-item.schema.json",
  "title": "EvidenceMark Knowledge Item",
  "type": "object",
  "required": [
    "id",
    "title",
    "kind",
    "source",
    "authority",
    "classification",
    "statement",
    "provenance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "fact",
        "inference",
        "recommendation",
        "decision",
        "pattern",
        "anti-pattern"
      ]
    },
    "source": {
      "type": "string",
      "format": "uri"
    },
    "authority": {
      "enum": [
        "aws_official",
        "vendor_maintained",
        "community_project",
        "community_curation",
        "internal"
      ]
    },
    "classification": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "required": [
        "retrieved_at"
      ],
      "properties": {
        "revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "license": {
          "type": [
            "string",
            "null"
          ]
        },
        "content_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "status": {
      "enum": [
        "draft",
        "reviewed",
        "approved",
        "deprecated"
      ],
      "default": "draft"
    },
    "review": {
      "type": "object",
      "properties": {
        "reviewer": {
          "type": "string"
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "stale_after": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
